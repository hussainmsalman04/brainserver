# Copy to .env.local for local dev (vercel dev). Never commit .env.local.
# In production these are set in the Vercel dashboard → Project → Settings → Environment Variables.

# Fine-grained PAT scoped to the vault repo only, with Contents: Read/Write.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Vault repo coordinates
GITHUB_REPO_OWNER=aayuushh365
GITHUB_REPO_NAME=ClawMemory
GITHUB_BRANCH=main

# Shared secret claude.ai sends in the Authorization header (`Bearer <secret>`).
# Generate any high-entropy random string. Used to gate the MCP server.
MCP_BEARER_TOKEN=replace-with-a-long-random-string
